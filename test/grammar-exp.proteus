---
console.log("test")
---

$ = #init? _ #(rule _)*
    ---(init, rules)
    return {
        init,
        rules: rules.map(rule => rule[0])
    }
    ---
@rule = #(rulename | "$") #(__ ("." name __)? "=" items action?)+
    ---(name, defs)
    return {
        type: "rule",
        name,
        defs: defs.map(
            (def, index) => ({
                name: def[1]?.[1] ?? index.toString(),
                seq: def[3],
                action: def[4]
            })
        )
    }
    ---

@delim = _ "---" "\n"?
@codeLine = [\s]* !"---\n" [^\n]* "\n"
@init = delim #{ codeLine+ } delim

@actionDelim = _ "---" #{ "(" [^\)\n]* ")" } "\n"
@action = #actionDelim #{ codeLine+ } delim
    ---(args, code)
    return { args, code }
    ---

@items = #(__ item)*
    ---(list)
    return list.map(item => item[1])
    ---
@item
    .normal = #"#"? #(string | chars | ruleref | seq | or | join) #("*" | "+" | "?")?
    .negate = "!" #(seq | ruleref | string)

@string
    .dbl = #{ '"' (stresc | [^"] )* '"' }
    .sgl = #{ "'" (stresc | [^'] )* "'" }
@stresc = "\\" [\\rntvbxu'"]
@chars = #{ "[" (range | ch)+ "]" } #{"i"? "m"?}
@ch
    = [^\-\]\\]
    = "\\" [snwrntvb\]\-\\\(\)\[\^\$]
@range = ch "-" ch
@ruleref = #name
@seq = "(" _ #item #items _ ")"
@or = "(" #item #(__ "|" __ item)+ _ ")"
@join = "{" _ #item #items _ "}"

@name = #{ [a-z0-9_]i+ }
@rulename = "@" #name

@_ = [\s]m*
@__ = [\s]m+
